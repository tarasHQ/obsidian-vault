{
  "biggerIcons": "mobile",
  "clickableIcons": "off",
  "showAllFileIcons": true,
  "showAllFolderIcons": false,
  "minimalFolderIcons": true,
  "showMarkdownTabIcons": true,
  "showTitleIcons": true,
  "showTagPillIcons": false,
  "showMenuActions": true,
  "showSuggestionIcons": false,
  "showQuickSwitcherIcons": true,
  "showMoveFileIcons": true,
  "showItemName": "desktop",
  "useSearchKeywords": "on",
  "maxSearchResults": 150,
  "colorPicker1": "rgb",
  "colorPicker2": "list",
  "uncolorHover": false,
  "uncolorDrag": false,
  "uncolorSelect": false,
  "uncolorQuick": false,
  "maxBackups": 2,
  "dialogState": {
    "iconMode": true,
    "emojiMode": true,
    "rulePage": "folder"
  },
  "appIcons": {},
  "tabIcons": {},
  "fileIcons": {},
  "bookmarkIcons": {},
  "tagIcons": {},
  "propertyIcons": {},
  "ribbonIcons": {},
  "fileRules": [
    {
      "id": "qp8Ko",
      "name": "README",
      "match": "all",
      "conditions": [
        {
          "source": "name",
          "operator": "contains",
          "value": "README"
        }
      ],
      "enabled": true,
      "icon": "lucide-info",
      "color": "#4177aa"
    },
    {
      "id": "Cpf7e",
      "name": "_reflections/.md",
      "match": "all",
      "conditions": [
        {
          "source": "path",
          "operator": "contains",
          "value": "_reflections"
        }
      ],
      "enabled": true,
      "icon": "lucide-brain",
      "color": "cyan"
    },
    {
      "id": "HwUDK",
      "name": ".md",
      "match": "all",
      "conditions": [
        {
          "source": "extension",
          "operator": "is",
          "value": "md"
        }
      ],
      "enabled": true,
      "icon": "lucide-file-text",
      "color": "#506d86"
    },
    {
      "id": "02eGg",
      "name": "Base",
      "match": "all",
      "conditions": [
        {
          "source": "extension",
          "operator": "is",
          "value": "base"
        }
      ],
      "enabled": true,
      "icon": "lucide-database",
      "color": "cyan"
    }
  ],
  "folderRules": [
    {
      "id": "kbM9c",
      "name": "__obsidian__",
      "match": "all",
      "conditions": [
        {
          "source": "name",
          "operator": "is",
          "value": "__obsidian__"
        }
      ],
      "enabled": true,
      "icon": "lucide-binary",
      "color": "red"
    },
    {
      "id": "NV3Ur",
      "name": "_static",
      "match": "all",
      "conditions": [
        {
          "source": "name",
          "operator": "is",
          "value": "_static"
        }
      ],
      "enabled": true,
      "icon": "lucide-folder-cog-2",
      "color": "#525252"
    },
    {
      "id": "fxssP",
      "name": "_private",
      "match": "all",
      "conditions": [
        {
          "source": "name",
          "operator": "is",
          "value": "_private"
        }
      ],
      "enabled": true,
      "icon": "lucide-folder-key",
      "color": "#525252"
    },
    {
      "id": "dAH76",
      "name": "@projects",
      "match": "all",
      "conditions": [
        {
          "source": "name",
          "operator": "is",
          "value": "@projects"
        }
      ],
      "enabled": true,
      "icon": "lucide-workflow",
      "color": "#a1977d"
    },
    {
      "id": "cTG7C",
      "name": "@journal",
      "match": "all",
      "conditions": [
        {
          "source": "name",
          "operator": "is",
          "value": "@journal"
        }
      ],
      "enabled": true,
      "icon": "lucide-notebook"
    },
    {
      "id": "00tsM",
      "name": "@system",
      "match": "all",
      "conditions": [
        {
          "source": "name",
          "operator": "is",
          "value": "@system"
        }
      ],
      "enabled": true,
      "color": "#878580",
      "icon": "lucide-stone"
    }
  ]
}